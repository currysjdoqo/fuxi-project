ALLOWED_ORIGINS=http://localhost:80,http://localhost,http://127.0.0.1,http://43.108.18.169
WRONG_QUESTION_REMOVE_THRESHOLD=5
DEEPSEEK_API_KEY=

# 支付基础地址
# APP_BASE_URL：后端公网地址，用于接收支付宝异步回调（本地测试可用内网穿透地址）
# FRONTEND_BASE_URL：前端地址，支付完成后跳回该地址
APP_BASE_URL=http://43.108.18.169
FRONTEND_BASE_URL=http://43.108.18.169

# 支付宝电脑网站支付（alipay.trade.page.pay）
# 密钥用支付宝开放平台"密钥工具"生成；PEM 中的换行写成 \n
# 沙箱测试：APPID 用沙箱应用的 APPID，并打开下面的 ALIPAY_GATEWAY
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 沙箱网关（正式环境留空，默认走 openapi.alipay.com）
#ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 回调地址一般自动拼出，无需手动填；有反向代理/特殊路径时再覆盖
#ALIPAY_NOTIFY_URL=
#ALIPAY_RETURN_URL=
